APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clube_tenis
DB_USERNAME=clube
DB_PASSWORD=clube_local

REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
ACCESS_TOKEN_TTL_MINUTES=60

# E-mails (US16-US18). Sem RESEND_API_KEY os e-mails só aparecem no log.
RESEND_API_KEY=
MAIL_FROM="Clube de Tênis <nao-responda@spyno.app>"
APP_URL=http://localhost:5173
REMINDER_HOURS_BEFORE=24
# Token da rota interna de lembretes (POST /api/v1/internal/reminders, cabeçalho X-Cron-Token)
CRON_TOKEN=
